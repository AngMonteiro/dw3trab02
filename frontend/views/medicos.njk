{% extends "layout.njk" %}
{% block content %}
<header class="page-header">
  <p class="page-kicker text-primary fw-semibold mb-2">Cadastros</p>
  <h1 class="h3 fw-bold mb-0">Médicos</h1>
</header>

<div id="mensagem" class="alert d-none" role="alert"></div>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card border-0 shadow-sm page-card">
      <div class="card-body p-4">
        <h2 class="h5 fw-semibold mb-3" id="tituloForm">Novo médico</h2>
        <form id="formMedico">
          <input type="hidden" id="medicoid">
          <div class="mb-3">
            <label class="form-label" for="crm">CRM</label>
            <input class="form-control" id="crm" maxlength="20" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="nome">Nome</label>
            <input class="form-control" id="nome" maxlength="80" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="salario">Salário (R$)</label>
            <input class="form-control" id="salario" type="number" step="0.01" min="0" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="dataadmissao">Data de admissão</label>
            <input class="form-control" id="dataadmissao" type="date" required>
          </div>
          <div class="mb-3">
            <label class="form-label" for="especialidadeid">Especialidade</label>
            <select class="form-select" id="especialidadeid" required></select>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">Salvar</button>
            <button class="btn btn-outline-secondary" type="button" id="btnCancelar">Cancelar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card border-0 shadow-sm page-card">
      <div class="card-body p-4">
        <h2 class="h5 fw-semibold mb-3">Médicos cadastrados</h2>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead>
              <tr>
                <th>ID</th>
                <th>CRM</th>
                <th>Nome</th>
                <th>Especialidade</th>
                <th class="text-end">Salário</th>
                <th>Admissão</th>
                <th class="text-end">Ações</th>
              </tr>
            </thead>
            <tbody id="tabelaMedicos"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
{% block scripts %}
<script src="/apps/medicos/vwMedicos.js"></script>
{% endblock %}
